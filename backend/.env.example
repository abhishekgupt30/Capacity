# ── Required ──────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_BEFORE_RUNNING

# Database — change these defaults in production
DATABASE_URL=postgresql+asyncpg://capacita:capacita_dev_2024@localhost:5432/capacita_db

# ── Google Gemini ─────────────────────────────────────────────
# Server-side only. Never expose to frontend or client logs.
GOOGLE_API_KEY=
GEMINI_ENABLED=true
# 0 means unlimited application calls. A positive value is a persistent daily cap;
# provider billing/quota rules still apply.
GEMINI_DAILY_CALL_LIMIT=0
# Maximum Gemini model calls per analysis. Keep this low for free-tier usage.
AGENT_MAX_ITERATIONS=4

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
